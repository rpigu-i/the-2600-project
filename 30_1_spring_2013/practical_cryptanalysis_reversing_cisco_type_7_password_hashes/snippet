]

def encrypt(password):
seed = ord(os.urandom(1)) % 16
 return "%02d%s" % (
 seed,
 "".join(
  ["%02x" % (ord(password[i]) ^ xlat[seed + i])
  for i in range(len(password))]
 )
 )

def decrypt(h):
seed, h = int(h[:2]), h[2:]
 cipherBytes = [int(h[i : i + 2], 16) for i in range(0, len(h), 2)]
return "".join(
 [chr(cipherBytes[i] ^ xlat[(seed + i) % len(xlat)])
  for i in range(len(cipherBytes))]
 )

